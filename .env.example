# Local example. In hPanel, enter actual values privately, not placeholders.
# Use the separate preview app's HTTPS origin when deploying for review.
SITE_URL=http://localhost:3000
SITE_INDEXABLE=false
HOSTNAME=0.0.0.0
# PORT is assigned by Hostinger. Only set a local value for local testing.

# Optional for a pages-only preview. Required for quote submissions.
# Use a NEW database and user, never the original site's database.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Optional PEM CA certificate for a database requiring TLS; never disable verification.
# Literal \n sequences are accepted. Leave unset for Hostinger's local DB unless required.
DB_SSL_CA=
